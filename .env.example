GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# demo, gemini, or luna
AGENT_MODE=gemini
OPENAI_AGENT_MODEL=gpt-luna
# Optional. When set, app state uses Neon/Postgres instead of local SQLite.
DATABASE_URL=
# Optional vector DB. If unset, retrieval uses local NumPy embedding cache.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=resolvedesk_policies
# Optional LangSmith tracing for LangGraph, LLM calls, RAG, MCP tools, and evals.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=resolvedesk-local
# Required only for some org-scoped LangSmith keys.
LANGSMITH_WORKSPACE_ID=
OPENAI_API_KEY=
OPENAI_EVAL_MODEL=gpt-4o
# Optional estimated prices per million tokens; leave blank to report cost unavailable.
GEMINI_INPUT_PRICE=
GEMINI_OUTPUT_PRICE=
OPENAI_INPUT_PRICE=
OPENAI_OUTPUT_PRICE=
